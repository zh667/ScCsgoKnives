<Project Sdk="Microsoft.NET.Sdk">
  <!-- current-direction-20260929 §6 M0 prototype only: never part of the delivered packages. Compiled against the same
       1.9.3.1 API as the core, so the same package root DLL loads on 1.9.3.1 and on the 1.9.3.2_MP engine. -->
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <RootNamespace>Game</RootNamespace>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>ScCsgoNetProbe</AssemblyName>
    <Deterministic>true</Deterministic>
    <LangVersion>preview</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <DebugType>none</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="SurvivalcraftAPI.Survivalcraft" Version="1.9.3.1" />
  </ItemGroup>
</Project>
