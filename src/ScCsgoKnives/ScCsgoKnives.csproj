<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">AnyCPU</Platform>
    <OutputType>Library</OutputType>
    <RootNamespace>Game</RootNamespace>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>ScCsgoKnives</AssemblyName>
    <Deterministic>true</Deterministic>
    <LangVersion>preview</LangVersion>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <Nullable>disable</Nullable>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateDependencyFile>false</GenerateDependencyFile>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
    <DebugType>pdbonly</DebugType>
    <OutputPath>bin\Debug\</OutputPath>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
    <DebugType>none</DebugType>
    <OutputPath>bin\Release\</OutputPath>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="SurvivalcraftAPI.Survivalcraft" Version="1.9.2.1" />
  </ItemGroup>
  <ItemGroup>
    <None Update="modinfo.json"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></None>
    <None Update="Assets\**\*"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></None>
    <None Include="..\..\LICENSE" Link="LICENSE"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></None>
    <None Include="..\..\THIRD_PARTY_NOTICES.md" Link="THIRD_PARTY_NOTICES.md"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></None>
    <None Include="..\..\ASSET_SOURCES.md" Link="ASSET_SOURCES.md"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></None>
  </ItemGroup>
  <ItemGroup>
    <Compile Include="**\*.cs" Exclude="bin\**;obj\**" />
    <EmbeddedResource Include="AnimationData\*.animation.json" />
    <EmbeddedResource Include="AnimationData\cs2_sounds.json" />
    <EmbeddedResource Include="AnimationData\knives.json" />
    <EmbeddedResource Include="AnimationData\guns.json" />
    <EmbeddedResource Include="AnimationData\weapon_table.json" />
    <EmbeddedResource Include="Shaders\*.vsh;Shaders\*.psh" />
  </ItemGroup>
  <Target Name="PostBuild" AfterTargets="PostBuildEvent">
    <PropertyGroup><PathOfScmod>$(TargetDir)..\$(AssemblyName).scmod</PathOfScmod></PropertyGroup>
    <ZipDirectory SourceDirectory="$(TargetDir)" DestinationFile="$(PathOfScmod)" Overwrite="true" />
    <Message Text="Created: $(PathOfScmod)" Importance="high" />
  </Target>
</Project>
