#version 300 es
// Metallic-roughness PBR for the first-person knife (GLSL ES 3.00 so it runs on
// every device Survivalcraft API 1.9 does).
//
// Lighting = CS:MC's own prefiltered "studio" environment (image based, world
// aligned so reflections sweep as the player turns) + Survivalcraft's two fixed
// directional lights + an occlusion map. Everything is scaled by the item light
// value so the blade goes dark in a cave like any other held item.
//
// Environment atlas: 6 rows (roughness 0..1) x 6 GL cube faces (+X -X +Y -Y +Z -Z),
// 128px tiles, RGBM encoded (rgb * a * range). The BRDF lookup is the split-sum
// (N.V, roughness) -> (scale, bias) table generated by tools/export_pbr_textures.py.
precision highp float;

// <Sampler Name='u_baseSampler' Texture='u_baseColor' />
// <Sampler Name='u_ormSampler' Texture='u_orm' />
// <Sampler Name='u_normalSampler' Texture='u_normalMap' />
// <Sampler Name='u_envSampler' Texture='u_env' />
// <Sampler Name='u_brdfSampler' Texture='u_brdf' />

uniform sampler2D u_baseColor;   // sRGB
uniform sampler2D u_orm;         // R = occlusion, G = roughness, B = metalness
uniform sampler2D u_normalMap;   // tangent space
uniform sampler2D u_env;         // prefiltered specular atlas, RGBM
uniform sampler2D u_brdf;        // split-sum LUT

uniform mat4 u_viewToWorld;      // rotation only: view-space direction -> world (env is world aligned)
uniform vec3 u_lightDir1;        // view space, unit, towards the light
uniform vec3 u_lightDir2;
uniform vec3 u_lightColor1;
uniform vec3 u_lightColor2;
uniform vec4 u_params;           // x = env RGBM range, y = env intensity, z = exposure, w = flip normal Y (0/1)
uniform vec4 u_params2;          // x = roughness bias, y = env yaw (radians), z = env saturation (0 = grey), w = debug view

in vec3 v_viewPos;
in vec3 v_viewNormal;
in vec2 v_texcoord;

out vec4 fragColor;

const float PI = 3.14159265;
const float ENV_LEVELS = 6.0;
const float ENV_TILE = 128.0;

vec3 srgbToLinear(vec3 c) { return pow(c, vec3(2.2)); }
vec3 linearToSrgb(vec3 c) { return pow(max(c, vec3(0.0)), vec3(1.0 / 2.2)); }

// Narkowicz ACES fit.
vec3 tonemap(vec3 x) {
	return clamp((x * (2.51 * x + 0.03)) / (x * (2.43 * x + 0.59) + 0.14), 0.0, 1.0);
}

// Tangent frame from screen-space derivatives (Schueler), so the OBJ meshes need
// no tangent attribute.
mat3 cotangentFrame(vec3 N, vec3 p, vec2 uv) {
	vec3 dp1 = dFdx(p);
	vec3 dp2 = dFdy(p);
	vec2 duv1 = dFdx(uv);
	vec2 duv2 = dFdy(uv);
	vec3 dp2perp = cross(dp2, N);
	vec3 dp1perp = cross(N, dp1);
	vec3 T = dp2perp * duv1.x + dp1perp * duv2.x;
	vec3 B = dp2perp * duv1.y + dp1perp * duv2.y;
	float invmax = inversesqrt(max(dot(T, T), dot(B, B)) + 1e-12);
	return mat3(T * invmax, B * invmax, N);
}

// One tile of the cube atlas: GL cube-map face selection and face UV.
vec3 sampleEnvLevel(vec3 d, float row) {
	vec3 a = abs(d);
	float face;
	vec2 uv;
	float m;
	if (a.x >= a.y && a.x >= a.z) {
		m = a.x;
		if (d.x > 0.0) { face = 0.0; uv = vec2(-d.z, -d.y); }
		else           { face = 1.0; uv = vec2( d.z, -d.y); }
	}
	else if (a.y >= a.z) {
		m = a.y;
		if (d.y > 0.0) { face = 2.0; uv = vec2( d.x,  d.z); }
		else           { face = 3.0; uv = vec2( d.x, -d.z); }
	}
	else {
		m = a.z;
		if (d.z > 0.0) { face = 4.0; uv = vec2( d.x, -d.y); }
		else           { face = 5.0; uv = vec2(-d.x, -d.y); }
	}
	uv = (uv / m + 1.0) * 0.5;
	// Keep bilinear taps inside the tile.
	float pad = 0.5 / ENV_TILE;
	uv = clamp(uv, vec2(pad), vec2(1.0 - pad));
	vec2 atlas = vec2((face + uv.x) / 6.0, (row + uv.y) / ENV_LEVELS);
	vec4 t = texture(u_env, atlas);
	vec3 c = t.rgb * t.a * u_params.x;
	// Desaturate: keep the environment's brightness structure (what a blade
	// mirrors) without tinting the metal the colour of the sky.
	float l = dot(c, vec3(0.2126, 0.7152, 0.0722));
	return mix(vec3(l), c, u_params2.z);
}

vec3 sampleEnv(vec3 d, float roughness) {
	float level = clamp(roughness, 0.0, 1.0) * (ENV_LEVELS - 1.0);
	float r0 = floor(level);
	float r1 = min(r0 + 1.0, ENV_LEVELS - 1.0);
	return mix(sampleEnvLevel(d, r0), sampleEnvLevel(d, r1), level - r0);
}

// GGX / Schlick / height-correlated Smith visibility.
float D_GGX(float NoH, float a2) {
	float d = NoH * NoH * (a2 - 1.0) + 1.0;
	return a2 / (PI * d * d + 1e-7);
}
float V_SmithGGX(float NoV, float NoL, float a2) {
	float gv = NoL * sqrt(NoV * NoV * (1.0 - a2) + a2);
	float gl = NoV * sqrt(NoL * NoL * (1.0 - a2) + a2);
	return 0.5 / (gv + gl + 1e-7);
}
vec3 F_Schlick(vec3 f0, float VoH) {
	float f = pow(1.0 - VoH, 5.0);
	return f0 + (1.0 - f0) * f;
}

vec3 directLight(vec3 L, vec3 color, vec3 N, vec3 V, vec3 diffuseColor, vec3 f0, float a2) {
	float NoL = max(dot(N, L), 0.0);
	if (NoL <= 0.0) return vec3(0.0);
	vec3 H = normalize(L + V);
	float NoV = max(dot(N, V), 1e-4);
	float NoH = max(dot(N, H), 0.0);
	float VoH = max(dot(V, H), 0.0);
	vec3 F = F_Schlick(f0, VoH);
	vec3 spec = F * (D_GGX(NoH, a2) * V_SmithGGX(NoV, NoL, a2));
	vec3 diff = (1.0 - F) * diffuseColor / PI;
	return (diff + spec) * color * NoL;
}

void main()
{
	vec3 base = srgbToLinear(texture(u_baseColor, v_texcoord).rgb);
	vec3 orm = texture(u_orm, v_texcoord).rgb;
	float ao = orm.r;
	float roughness = clamp(orm.g + u_params2.x, 0.04, 1.0);
	float metallic = orm.b;

	vec3 Ng = normalize(v_viewNormal);
	// Two-sided: the meshes are drawn without culling, so light the side that faces us.
	vec3 V = normalize(-v_viewPos);
	if (dot(Ng, V) < 0.0) Ng = -Ng;
	vec3 tn = texture(u_normalMap, v_texcoord).rgb * 2.0 - 1.0;
	if (u_params.w > 0.5) tn.y = -tn.y;
	vec3 N = normalize(cotangentFrame(Ng, v_viewPos, v_texcoord) * tn);

	vec3 f0 = mix(vec3(0.04), base, metallic);
	vec3 diffuseColor = base * (1.0 - metallic);
	float a = roughness * roughness;
	float a2 = a * a;
	float NoV = max(dot(N, V), 1e-4);

	// Image based lighting, world aligned.
	mat3 toWorld = mat3(u_viewToWorld);
	float yaw = u_params2.y;
	mat3 yawRot = mat3(cos(yaw), 0.0, -sin(yaw), 0.0, 1.0, 0.0, sin(yaw), 0.0, cos(yaw));
	vec3 Nw = yawRot * (toWorld * N);
	vec3 Rw = yawRot * (toWorld * reflect(-V, N));
	vec2 brdf = texture(u_brdf, vec2(NoV, roughness)).rg;
	vec3 irradiance = sampleEnv(Nw, 1.0);
	vec3 prefiltered = sampleEnv(Rw, roughness);
	vec3 iblDiffuse = irradiance * diffuseColor;
	vec3 iblSpecular = prefiltered * (f0 * brdf.x + brdf.y);
	vec3 ibl = (iblDiffuse + iblSpecular) * ao * u_params.y;

	vec3 direct = directLight(normalize(u_lightDir1), u_lightColor1, N, V, diffuseColor, f0, a2)
	            + directLight(normalize(u_lightDir2), u_lightColor2, N, V, diffuseColor, f0, a2);
	direct *= mix(1.0, ao, 0.5);

	vec3 color = (ibl + direct) * u_params.z;
	vec3 outColor = linearToSrgb(tonemap(color));

	float debugView = u_params2.w;
	if (debugView > 0.5) {
		if (debugView < 1.5) outColor = texture(u_baseColor, v_texcoord).rgb;
		else if (debugView < 2.5) outColor = N * 0.5 + 0.5;
		else if (debugView < 3.5) outColor = vec3(roughness);
		else if (debugView < 4.5) outColor = vec3(metallic);
		else if (debugView < 5.5) outColor = linearToSrgb(tonemap(prefiltered * u_params.z));
		else if (debugView < 6.5) outColor = vec3(ao);
		else outColor = linearToSrgb(tonemap(direct * u_params.z));
	}
	fragColor = vec4(outColor, 1.0);
}
